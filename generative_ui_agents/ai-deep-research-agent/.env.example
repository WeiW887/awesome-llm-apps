# Deep Research Assistant - Environment Variables

# Backend Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8123

# Frontend → Backend Connection
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2

# Optional: use any OpenAI-compatible provider instead of OpenAI.
# Free option — Groq (https://console.groq.com, no credit card):
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# Leave OPENAI_BASE_URL unset to use the official OpenAI API.
# OPENAI_BASE_URL=

# Tavily API (https://app.tavily.com/)
TAVILY_API_KEY=tvly-...
